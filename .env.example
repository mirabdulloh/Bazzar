NODE_ENV=production
PORT_API=3007

# Database
MONGO_DEV=mongodb://127.0.0.1:27017/bazaar_dev
MONGO_PROD=mongodb://127.0.0.1:27017/bazaar_prod

# Auth
SECRET_TOKEN=replace-with-strong-access-token-secret
REFRESH_TOKEN_SECRET=replace-with-strong-refresh-token-secret

# Frontend / CORS
FRONTEND_URL=https://example.com
CORS_ORIGIN=https://example.com,https://www.example.com
TRUST_PROXY=true

# Mail
MAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
MAIL_USER=replace-me
MAIL_PASS=replace-me
MAIL_FROM=Bazaar <no-reply@bazaarshop.me>
